# All AI calls (transcription, triage, daily digest) go through OpenRouter.
OPENROUTER_API_KEY=

# Model choices — defaults come from bench/RESULTS.md (run `npm run bench` to re-test).
# TRANSCRIBE_MODEL=xiaomi/mimo-v2.6-flash
# TRIAGE_MODEL=openai/gpt-6-luna
# DIGEST_MODEL=openai/gpt-6-luna-pro

# Jev (TypeSafe System One) via OpenRouter's passthrough — the speech/newsworthy gate, shadow mode.
# JEV_MODEL=~typesafe/jev-latest

# Optional: call Claude models directly instead of via OpenRouter.
# ANTHROPIC_API_KEY=

# Optional: a Whisper-style endpoint instead of OpenRouter for speech-to-text (Groq, OpenAI, local whisper.cpp).
# TRANSCRIBE_BASE_URL=https://api.groq.com/openai/v1
# TRANSCRIBE_API_KEY=

# Broadcastify = RadioReference account (same login). Use the RadioReference *username*, not the email.
# Sent as HTTP Basic auth when pulling audio.broadcastify.com streams — requires a Premium subscription.
BROADCASTIFY_LOGIN=
BROADCASTIFY_PASSWORD=

# Optional, when sharing through Cloudflare Access (docs/SHARING.md): emails that count as owners —
# they can flip the Remote transcripts switch and listen live on this receiver's Broadcastify account.
# OWNER_EMAILS=you@example.com

# Optional: live AIS ship positions on Mobile Bay / Pascagoula (free key at aisstream.io)
AISSTREAM_API_KEY=

# PORT=8077
# SEGMENT_SECONDS=45
# RECORD_DAYS=7        # every transmission's audio is kept this long; digest highlights are kept forever
# INGEST=0             # serve the map only, no audio ingest
